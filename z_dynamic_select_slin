DATA: gv_table TYPE tabname,
      gv_field TYPE fieldname,
      gv_join  TYPE int1.

SELECTION-SCREEN BEGIN OF BLOCK b1.
  SELECT-OPTIONS: s_tables FOR gv_table OBLIGATORY NO INTERVALS,
                  s_vfield FOR gv_field OBLIGATORY NO INTERVALS,
                  s_fields FOR gv_field OBLIGATORY NO INTERVALS,
                  s_joins  FOR gv_join NO INTERVALS.

  PARAMETERS: p_filter AS CHECKBOX,
              p_rows   TYPE int1.
SELECTION-SCREEN END OF BLOCK b1.

CLASS main DEFINITION FINAL.
  PUBLIC SECTION.
    METHODS run.

  PRIVATE SECTION.
    TYPES: BEGIN OF ty_field,
             field TYPE fieldname,
           END OF ty_field,

           stty_fields TYPE STANDARD TABLE OF string WITH DEFAULT KEY,
           htty_fields TYPE HASHED TABLE OF ty_field WITH UNIQUE KEY field,
           stty_dfies  TYPE STANDARD TABLE OF dfies WITH DEFAULT KEY,

           BEGIN OF ty_table_fields,
             table  TYPE tabname,
             fields TYPE htty_fields,
           END OF ty_table_fields,

           BEGIN OF ty_select_field,
             field        TYPE fieldname,
             data_element TYPE rollname,
           END OF ty_select_field.

    DATA: mt_table_fields  TYPE STANDARD TABLE OF ty_table_fields,
          mt_select_fields TYPE STANDARD TABLE OF ty_select_field,

          mv_from          TYPE string,
          mv_select        TYPE string.

    METHODS: read_input,

             read_tables,

             process_table_field   IMPORTING iv_table         TYPE tabname,

             validate_table        IMPORTING iv_table         TYPE tabname
                                             it_package       TYPE string_hashed_table OPTIONAL,

             parse_valid_field     IMPORTING iv_field         TYPE fieldname
                                             iv_table         TYPE tabname
                                             iv_delimiter     TYPE char1 DEFAULT ',',

             create_table_field    IMPORTING iv_table         TYPE tabname
                                             it_fields        TYPE stty_fields,

             create_field_table    IMPORTING iv_table         TYPE tabname
                                             it_fields        TYPE stty_fields
                                   RETURNING VALUE(rt_output) TYPE htty_fields,

             get_table_fields      IMPORTING iv_table         TYPE ddobjname
                                             iv_field         TYPE fieldname OPTIONAL
                                   RETURNING VALUE(rt_output) TYPE stty_dfies,

             add_from              IMPORTING is_table_field   TYPE ty_table_fields
                                             iv_index         TYPE syst_tabix,

             get_join              IMPORTING iv_index         TYPE syst_tabix
                                   RETURNING VALUE(rv_output) TYPE string,

             get_on                IMPORTING iv_index         TYPE syst_tabix
                                             is_table_field   TYPE ty_table_fields
                                   RETURNING VALUE(rv_output) TYPE string,

             get_join_condition    IMPORTING is_table_field   TYPE ty_table_fields
                                   RETURNING VALUE(rt_output) TYPE stty_fields,

             find_join_table       IMPORTING iv_field         TYPE fieldname
                                   RETURNING VALUE(rv_output) TYPE string,

             read_fields,

             validate_select_field IMPORTING iv_field         TYPE fieldname
                                   RETURNING VALUE(rv_output) TYPE abap_boolean,

             search_field          IMPORTING is_table_field   TYPE ty_table_fields
                                             iv_field         TYPE fieldname
                                   RETURNING VALUE(rv_output) TYPE abap_boolean,

             add_select            IMPORTING iv_field         TYPE fieldname
                                             iv_table         TYPE tabname,

             run_select,

             get_where             RETURNING VALUE(rv_output) TYPE string,

             get_selection_id      RETURNING VALUE(rv_output) TYPE dynselid,

             get_where_lines       IMPORTING iv_selection_id  TYPE dynselid
                                   RETURNING VALUE(rt_output) TYPE rsds_twhere,

             get_processed_lines   IMPORTING it_lines         TYPE rsds_twhere
                                             iv_char          TYPE c DEFAULT '('
                                   RETURNING VALUE(rv_output) TYPE string.
ENDCLASS.

CLASS main IMPLEMENTATION.
  METHOD run.
    read_input( ).
    run_select( ).
  ENDMETHOD.

  METHOD read_input.
    read_tables( ).
    read_fields( ).
  ENDMETHOD.

  METHOD read_tables.
    LOOP AT s_tables ASSIGNING FIELD-SYMBOL(<lfs_table>).
      process_table_field( condense( <lfs_table>-low ) ).
    ENDLOOP.
  ENDMETHOD.

  METHOD process_table_field.
    validate_table( iv_table ).

    TRY.
        parse_valid_field( iv_field = VALUE #( s_vfield[ sy-tabix ]-low ) iv_table = iv_table ).
      CATCH cx_sy_itab_line_not_found.
        MESSAGE |{ 'Missing valid fields for'(002) } { iv_table }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.

  METHOD validate_table.
    TRY.
        cl_abap_dyn_prg=>check_table_name_tab( val      = iv_table
                                               packages = it_package ).
      CATCH cx_abap_not_a_table.
        MESSAGE |{ iv_table } { 'does not exist'(001) }| TYPE 'E'.
      CATCH cx_abap_not_in_package.
        MESSAGE |{ iv_table } { 'does not exist in valid package'(015) }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.

  METHOD parse_valid_field.
    SPLIT iv_field AT iv_delimiter INTO TABLE FINAL(lt_fields).

    create_table_field( iv_table = iv_table it_fields = lt_fields ).
  ENDMETHOD.

  METHOD create_table_field.
    FINAL(ls_table_field) = VALUE ty_table_fields( table = iv_table fields = create_field_table( iv_table = iv_table it_fields = it_fields ) ).

    add_from( is_table_field = ls_table_field iv_index = sy-tabix ).
  ENDMETHOD.

  METHOD create_field_table.
    FINAL(lt_fields) = VALUE htty_fields( FOR ls_table_field IN get_table_fields( iv_table ) ( field = ls_table_field-fieldname ) ).

    LOOP AT it_fields ASSIGNING FIELD-SYMBOL(<lfs_field>).
      FINAL(lv_condense_field) = CONV fieldname( condense( <lfs_field> ) ).

      IF NOT line_exists( lt_fields[ field = lv_condense_field ] ).
        MESSAGE |{ iv_table } { 'does not have'(003) } { lv_condense_field }| TYPE 'E'.
      ENDIF.

      IF NOT line_exists( rt_output[ field = lv_condense_field ] ) AND lv_condense_field IS NOT INITIAL.
        INSERT VALUE #( field = lv_condense_field ) INTO TABLE rt_output.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD get_table_fields.
    CALL FUNCTION 'DDIF_FIELDINFO_GET'
      EXPORTING tabname   = iv_table
                fieldname = iv_field
      TABLES    dfies_tab = rt_output.
  ENDMETHOD.

  METHOD add_from.
    mv_from &&= COND string( WHEN iv_index > 1
                             THEN | { get_join( iv_index ) } { is_table_field-table } { get_on( iv_index = iv_index is_table_field = is_table_field ) }|
                             ELSE is_table_field-table ).

    APPEND is_table_field TO mt_table_fields.
  ENDMETHOD.

  METHOD get_join.
    TRY.
        rv_output = SWITCH #( s_joins[ iv_index - 1 ]-low
                              WHEN 1 THEN 'INNER JOIN'
                              WHEN 2 THEN 'LEFT OUTER JOIN'
                              WHEN 3 THEN 'RIGHT OUTER JOIN'
                              WHEN 4 THEN 'CROSS JOIN'
                              ELSE THROW cx_sy_itab_line_not_found( ) ).
      CATCH cx_sy_itab_line_not_found.
        MESSAGE |{ 'Missing join for'(005) } { s_tables[ iv_index - 1 ]-low } { s_tables[ iv_index ]-low }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.

  METHOD get_on.
    TRY.
        rv_output = SWITCH #( s_joins[ iv_index - 1 ]-low
                              WHEN 4
                              THEN ''
                              ELSE |ON { REDUCE #( INIT output TYPE string sep TYPE string FOR lv_line IN get_join_condition( is_table_field ) NEXT output &&= |{ sep } { lv_line }| sep = | AND| ) }| ).
      CATCH cx_sy_itab_line_not_found.
        MESSAGE |{ 'Missing join for'(005) } { s_tables[ iv_index - 1 ]-low } { s_tables[ iv_index ]-low }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.

  METHOD get_join_condition.
    LOOP AT is_table_field-fields ASSIGNING FIELD-SYMBOL(<lfs_field>).
      FINAL(lv_table) = find_join_table( <lfs_field>-field ).

      IF lv_table IS NOT INITIAL.
        APPEND |{ lv_table }~{ <lfs_field>-field } = { is_table_field-table }~{ <lfs_field>-field }| TO rt_output.
      ENDIF.
    ENDLOOP.

    IF rt_output IS INITIAL.
      MESSAGE |{ 'No common fields to join for table'(009) } { is_table_field-table }| TYPE 'E'.
    ENDIF.
  ENDMETHOD.

  METHOD find_join_table.
    LOOP AT mt_table_fields ASSIGNING FIELD-SYMBOL(<lfs_table_field>).
      IF line_exists( <lfs_table_field>-fields[ field = iv_field ] ).
        RETURN <lfs_table_field>-table.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD read_fields.
    DATA lt_seen TYPE HASHED TABLE OF ty_field WITH UNIQUE KEY field.

    LOOP AT s_fields ASSIGNING FIELD-SYMBOL(<lfs_field>).
      FINAL(lv_condensed_field) = condense( <lfs_field>-low ).

      IF line_exists( lt_seen[ field = CONV #( lv_condensed_field ) ] ).
        MESSAGE |{ 'Duplicate select field'(010) } { lv_condensed_field }| TYPE 'E'.
      ENDIF.

      IF validate_select_field( CONV #( lv_condensed_field ) ) = abap_false.
        MESSAGE |{ 'Could not find table with valid field'(014) } { lv_condensed_field }| TYPE 'E'.
      ENDIF.

      INSERT VALUE #( field = lv_condensed_field ) INTO TABLE lt_seen.
    ENDLOOP.

    IF mt_select_fields IS INITIAL.
      MESSAGE |{ 'Could not find any logic for select fields'(013) }| TYPE 'E'.
    ENDIF.
  ENDMETHOD.

  METHOD validate_select_field.
    LOOP AT mt_table_fields ASSIGNING FIELD-SYMBOL(<lfs_table_field>).
      IF search_field( is_table_field = <lfs_table_field> iv_field = iv_field ) = abap_true.
        RETURN abap_true.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD search_field.
    IF line_exists( is_table_field-fields[ field = iv_field ] ).
      add_select( iv_field = iv_field iv_table = is_table_field-table ).

      rv_output = abap_true.
    ENDIF.
  ENDMETHOD.

  METHOD add_select.
    FINAL(lt_field_catalog) = get_table_fields( iv_table = iv_table iv_field = iv_field ).
    APPEND VALUE #( field = |{ iv_field }| data_element = lt_field_catalog[ 1 ]-rollname )
        TO mt_select_fields.

    mv_select &&= COND #( WHEN mv_select IS NOT INITIAL
                          THEN |, { iv_table }~{ iv_field }|
                          ELSE |{ iv_table }~{ iv_field }| ).
  ENDMETHOD.

  METHOD run_select.
    CONSTANTS lc_default_row TYPE int1 VALUE 255.

    DATA lr_table_ref TYPE REF TO data.

    FINAL(lo_table_type) = cl_abap_tabledescr=>get( p_line_type = cl_abap_structdescr=>get( p_components = VALUE #( FOR ls_select_field IN mt_select_fields
                                                                                                                    ( name = ls_select_field-field
                                                                                                                      type = CAST #( cl_abap_elemdescr=>describe_by_name(
                                                                                                                                         p_name = ls_select_field-data_element ) ) ) ) ) ).
    CREATE DATA lr_table_ref TYPE HANDLE lo_table_type.
    ASSIGN lr_table_ref->* TO FIELD-SYMBOL(<lfs_data_table>).

    FINAL(lv_rows) = COND #( WHEN p_rows IS INITIAL THEN lc_default_row ELSE p_rows ).

    IF p_filter IS NOT INITIAL.
      FINAL(lv_where) = get_where( ).

      SELECT (mv_select)
        FROM (mv_from)
        WHERE (lv_where)
        INTO TABLE @<lfs_data_table>
        UP TO @lv_rows ROWS.

    ELSE.
      SELECT (mv_select)
        FROM (mv_from)
        INTO TABLE @<lfs_data_table>
        UP TO @lv_rows ROWS.
    ENDIF.

    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = FINAL(lt_alv_table)
                                CHANGING  t_table      = <lfs_data_table> ).

        lt_alv_table->get_columns( )->set_optimize( ).
        lt_alv_table->display( ).
      CATCH cx_salv_data_error.
        MESSAGE |{ 'Issue with ALV Table'(008) }| TYPE 'E'.
      CATCH cx_salv_msg.
        MESSAGE |{ 'Issue getting ALV Table'(007) }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.

  METHOD get_where.
    rv_output = get_processed_lines( get_where_lines( get_selection_id( ) ) ).
  ENDMETHOD.

  METHOD get_selection_id.
    DATA lt_table TYPE TABLE OF rsdstabs.

    lt_table = VALUE #( FOR ls_row IN mt_table_fields ( prim_tab = ls_row-table ) ).
    CALL FUNCTION 'FREE_SELECTIONS_INIT'
      IMPORTING selection_id = rv_output
      TABLES    tables_tab   = lt_table.
  ENDMETHOD.

  METHOD get_where_lines.
    DATA lt_field_tab TYPE TABLE OF rsdsfields.

    CALL FUNCTION 'FREE_SELECTIONS_DIALOG'
      EXPORTING  selection_id  = iv_selection_id
      IMPORTING  where_clauses = rt_output
      TABLES     fields_tab    = lt_field_tab
      EXCEPTIONS OTHERS        = 1.

    IF sy-subrc IS NOT INITIAL.
      RETURN.
    ENDIF.
  ENDMETHOD.

  METHOD get_processed_lines.
    LOOP AT it_lines ASSIGNING FIELD-SYMBOL(<lfs_line>).
      LOOP AT <lfs_line>-where_tab ASSIGNING FIELD-SYMBOL(<where_line>).
        SPLIT <where_line> AT space INTO TABLE FINAL(lt_substring).

        DATA(lv_found) = abap_false.

        LOOP AT lt_substring ASSIGNING FIELD-SYMBOL(<lfs_substring>).
          IF <lfs_substring> IS INITIAL.
            CONTINUE.
          ENDIF.

          rv_output &&= COND #( WHEN lv_found = abap_true
                                THEN |{ <lfs_line>-tablename }~{ <lfs_substring> } |
                                ELSE |{ <lfs_substring> } | ).

          lv_found = COND #( WHEN <lfs_substring> = iv_char THEN abap_true ELSE abap_false ).
        ENDLOOP.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
  NEW main( )->run( ).
