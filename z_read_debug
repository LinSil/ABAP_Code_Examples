SELECTION-SCREEN BEGIN OF BLOCK b1.
  PARAMETERS: p_file   TYPE string OBLIGATORY, "Directory of spreadsheet
              p_value  TYPE cstring,           "Input for value
              p_field  TYPE cstring,           "Input for field name
              p_strict AS CHECKBOX.            "Flag for if field name search is strict
SELECTION-SCREEN END OF BLOCK b1.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file. "Logic for event when user wants to search for spreadsheet locally
  DATA: lt_file_table TYPE filetable,
        lv_rc         TYPE i.

  "Function to display file explorer for user to select file from local device
  cl_gui_frontend_services=>file_open_dialog(
    CHANGING file_table = lt_file_table
             rc         = lv_rc ).

  "If user selected file, file name would be stored in file_table.
  "Since it only supports 1 file selection, it would be first index.
  IF line_exists( lt_file_table[ 1 ] ).
    p_file = lt_file_table[ 1 ]-filename.
  ENDIF.

CLASS main DEFINITION FINAL.
  PUBLIC SECTION.
    METHODS run.

  PRIVATE SECTION.
    TYPES: BEGIN OF ty_row,
             name TYPE cstring,
             val  TYPE cstring,
             type TYPE cstring,
           END OF ty_row,

           BEGIN OF ty_output,
             field TYPE cstring,
             value TYPE cstring,
           END OF ty_output.

    DATA: mv_null   TYPE abap_bool,
          mtr_data  TYPE REF TO data,
          mt_output TYPE STANDARD TABLE OF ty_output.

    METHODS: read_file,
             loop_data,
             display_data.
ENDCLASS.

CLASS main IMPLEMENTATION.
  METHOD run.
    "Check if user inputed either a value or field name. No point of running if both are blank. It would just display all values.
    "If both are blank, report will terminate exit processing block early.
    mv_null = COND #( WHEN p_value IS INITIAL AND p_field IS INITIAL
                      THEN abap_true
                      ELSE abap_false ).
    read_file( ).
    loop_data( ).
    display_data( ).
  ENDMETHOD.

  METHOD read_file.
    DATA lt_file TYPE STANDARD TABLE OF x.

    cl_gui_frontend_services=>gui_upload( EXPORTING filename = p_file
                                                    filetype = 'BIN'
                                          CHANGING  data_tab = lt_file ).

    CONCATENATE LINES OF lt_file INTO FINAL(lv_xstring) IN BYTE MODE.

    FINAL(lo_spreadsheet) = CAST if_fdt_doc_spreadsheet( NEW cl_fdt_xl_spreadsheet(
                                                                 document_name = p_file
                                                                 xdocument     = lv_xstring ) ).

    lo_spreadsheet->get_worksheet_names(
      IMPORTING worksheet_names = FINAL(lt_sheets) ).

    mtr_data = lo_spreadsheet->get_itab_from_worksheet(
                   worksheet_name = lt_sheets[ 1 ] ).
  ENDMETHOD.

  METHOD loop_data.
    DATA: lt_stack TYPE STANDARD TABLE OF cstring,
          ls_row   TYPE ty_row.

    LOOP AT mtr_data->* ASSIGNING FIELD-SYMBOL(<lfs_row>).
      DATA(lv_read) = 0.
      DATA(lv_index) = 0.

      LOOP AT CAST cl_abap_structdescr( cl_abap_structdescr=>describe_by_data(
                                            p_data = <lfs_row> ) )->components ASSIGNING FIELD-SYMBOL(<lfs_component>).
        ASSIGN COMPONENT <lfs_component>-name OF STRUCTURE <lfs_row> TO FIELD-SYMBOL(<lfs_value>).

        IF <lfs_value> IS INITIAL AND lv_read <= 0.
          CONTINUE.
        ENDIF.

        CASE lv_read.
          WHEN 0.
            ls_row-name = <lfs_value>.
            lv_index = sy-tabix.
          WHEN 1.
            ls_row-val = <lfs_value>.
          WHEN 2.
            ls_row-type = <lfs_value>.
        ENDCASE.

        IF lv_read = 2.
          EXIT.
        ENDIF.

        lv_read += 1.
      ENDLOOP.

      FINAL(lv_lines) = lines( lt_stack ).

      IF contains( val = ls_row-type sub = 'Structure' ) OR contains( val = ls_row-type sub = 'Table' ).
        IF lv_index > lv_lines.
          APPEND ls_row-name TO lt_stack.

        ELSEIF lv_index = lv_lines.
          lt_stack[ lv_index ] = ls_row-name.

        ELSE.
          DELETE lt_stack INDEX lv_lines.
        ENDIF.

      ELSE.
        IF lv_index = lv_lines.
          DELETE lt_stack INDEX lv_lines.
        ENDIF.

        CASE mv_null.
          WHEN abap_true.
            IF ls_row-val IS NOT INITIAL.
              CONTINUE.
            ENDIF.

          WHEN OTHERS.
            IF    ( p_value IS NOT INITIAL AND     p_value <> ls_row-val )
               OR ( p_field IS NOT INITIAL AND NOT (    ( p_strict IS NOT INITIAL AND ls_row-name = p_field )
                                                     OR ( p_strict IS INITIAL     AND contains( val = ls_row-name sub = p_field ) ) ) ).
              CONTINUE.
            ENDIF.
        ENDCASE.

        APPEND VALUE #( field = REDUCE #( INIT output TYPE string FOR name IN lt_stack NEXT output &&= |{ name }-| ) && ls_row-name
                        value = ls_row-val ) TO mt_output.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD display_data.
    "Create ALV table for output
    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = FINAL(lt_alv_table)
                                CHANGING  t_table      = mt_output ).

        lt_alv_table->get_columns( )->set_optimize( ).
        lt_alv_table->display( ).
      CATCH cx_salv_msg.
        MESSAGE |{ 'Issue getting ALV Table'(001) }| TYPE 'E'.
    ENDTRY.
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
  NEW main( )->run( ).
