  METHOD call_adobe_form.
    CONSTANTS: lc_form TYPE fpname VALUE 'Z_FORM_SLIN',
               lc_max  TYPE int1 VALUE 255.

    DATA: lv_num          TYPE int1 VALUE 1,
          lv_funcname     TYPE funcname,
          fp_docparams    TYPE sfpdocparams,
          fp_outputparams TYPE sfpoutputparams.

    "DATA(lv_string) = |Document { lv_num } |.

    TRY.
        CALL FUNCTION 'FP_FUNCTION_MODULE_NAME'
          EXPORTING
            i_name     = lc_form    " Form
          IMPORTING
            e_funcname = lv_funcname.
      CATCH cx_fp_api_repository.
        MESSAGE 'Error' TYPE 'E'.
      CATCH cx_fp_api_usage.
        MESSAGE 'Error' TYPE 'E'.
      CATCH cx_fp_api_internal.
        MESSAGE 'Error' TYPE 'E'.
    ENDTRY.

    WHILE lv_num < lc_max.

      CALL FUNCTION 'FP_JOB_OPEN'
        CHANGING
          ie_outputparams = fp_outputparams.

      CALL FUNCTION lv_funcname
        EXPORTING
          /1bcdwb/docparams = fp_docparams
          iv_num            = lv_num
          iv_name           = |Document { lv_num } |.

      CALL FUNCTION 'FP_JOB_CLOSE'.

      lv_num = lv_num + 1.
    ENDWHILE.


  ENDMETHOD.

  METHOD read_file.
    CONSTANTS: lc_fname TYPE string VALUE 'C:\Users\slin\Desktop\temp\Test_Text.txt'.

    DATA: lt_data TYPE STANDARD TABLE OF string.

    CALL FUNCTION 'GUI_UPLOAD'
      EXPORTING
        filename = lc_fname
