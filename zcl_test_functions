        data_tab = lt_data.

    BREAK-POINT.
  ENDMETHOD.

  METHOD read_application.
    CONSTANTS: lc_directory TYPE string VALUE '/interfaces/sap-in/Test_Text.txt'.
    DATA: lv_data TYPE string,
          lt_data TYPE TABLE OF string.

    OPEN DATASET lc_directory FOR INPUT IN TEXT MODE ENCODING DEFAULT WITH SMART LINEFEED.

    DO.
      READ DATASET lc_directory INTO lv_data.
      IF sy-subrc <> 0 OR lv_data IS INITIAL.
        RETURN.
      ENDIF.
      APPEND lv_data TO lt_data.
    ENDDO.

    BREAK-POINT.
  ENDMETHOD.

