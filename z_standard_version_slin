TABLES: vrsdynpro.

DATA: keep_pos                   TYPE bool,
      delta_only                 TYPE bool,
      with_korrnum               TYPE bool,
      korrtxt_lft                TYPE e07t-as4text,
      korrtxt_rgt                TYPE e07t-as4text,
      korrnum_rgt                TYPE vrsd-korrnum,
      e07t_entry                 TYPE e07t,
      logdest_rgt                TYPE rfcdes-rfcdest,
      korrnum_lft                TYPE vrsd-korrnum,
      logdest_lft                TYPE rfcdes-rfcdest,
      no_delta                   TYPE bool,
      gv_ignore_case_differences TYPE bool VALUE 'X',
      comp_mode                  TYPE vers_comp,
      abaptext_sec               TYPE STANDARD TABLE OF abaptxt255,
      abaptext_pri               TYPE STANDARD TABLE OF abaptxt255,
      trdir_sec                  TYPE STANDARD TABLE OF trdir,
      trdir_pri                  TYPE STANDARD TABLE OF trdir,
      trdir_delta                TYPE STANDARD TABLE OF xtrdir,
      abaptext_delta             TYPE STANDARD TABLE OF vxabapt255,
      version_lft                TYPE vrsd-versno,
      objtype_lft                TYPE vrsd-objtype,
      objname_lft                TYPE vrsd-objname,
      gt_smodilog_lft            TYPE STANDARD TABLE OF smodilog,
      version_rgt                TYPE vrsd-versno,
      objtype_rgt                TYPE vrsd-objtype,
      objname_rgt                TYPE vrsd-objname,
      gt_smodilog_rgt            TYPE STANDARD TABLE OF smodilog,
      one_column                 TYPE bool,
      objtyp1                    TYPE vrsd-objtype,
      objtyp2                    TYPE vrsd-objtype,
      gv_transport               TYPE trkorr,

      BEGIN OF fcode_tab OCCURS 5,
        fcode TYPE sy-ucomm,
      END OF fcode_tab.

INCLUDE: rsvcutct, rsvcrslt, rsvcrsst.

SELECT-OPTIONS: s_task FOR gv_transport NO INTERVALS OBLIGATORY.

CLASS main DEFINITION FINAL.
  PUBLIC SECTION.
    METHODS: run.
  PRIVATE SECTION.
    TYPES: BEGIN OF ty_object,
             type      TYPE trobjtype,
             name      TYPE versobjnam,
             transport TYPE strkorr,
           END OF ty_object,

           BEGIN OF ty_object_version,
             object_type    TYPE versobjtyp,
             object_name    TYPE versobjnam,
             object_version TYPE versno,
             last_version   TYPE versno,
           END OF ty_object_version,

           BEGIN OF ty_output,
             object_name TYPE versobjnam,
             line_number TYPE int2,
             new_code    TYPE string,
             old_code    TYPE string,
           END OF ty_output.

    CONSTANTS: mc_report    TYPE c LENGTH 4 VALUE 'REPS',
               mc_interface TYPE c LENGTH 4 VALUE 'SFPI',
               mc_method    TYPE c LENGTH 4 VALUE 'METH'.

    DATA: mt_object         TYPE STANDARD TABLE OF ty_object,
          mt_object_version TYPE STANDARD TABLE OF ty_object_version,
          mt_output         TYPE STANDARD TABLE OF ty_output.

    METHODS: read_task,
      get_object IMPORTING iv_task TYPE trkorr,
      get_data,
      process_data,
      set_version CHANGING cs_object_version TYPE ty_object_version,
      process_object IMPORTING is_object TYPE ty_object_version,
      set_code IMPORTING is_object TYPE ty_object_version,
      process_code IMPORTING is_object TYPE ty_object_version,
      process_interface IMPORTING is_object TYPE ty_object_version,
      call_comparison IMPORTING iv_object_name TYPE versobjnam,
      get_comp,
      call_delta,
      process_delta IMPORTING iv_object_name TYPE versobjnam,
      display_output,
      set_output_text IMPORTING iv_column TYPE lvc_fname
                                iv_text   TYPE scrtext
                                io_column TYPE REF TO cl_salv_columns_table.
ENDCLASS.

CLASS main IMPLEMENTATION.
  METHOD run.
    read_task( ).
    get_data( ).
    process_data( ).
    display_output( ).
  ENDMETHOD.

  METHOD read_task.
    LOOP AT s_task ASSIGNING FIELD-SYMBOL(<lfs_task>).
      get_object( <lfs_task>-low ).
    ENDLOOP.
  ENDMETHOD.

  METHOD get_object.
    DATA: ls_e070   TYPE e070,
          lt_object TYPE STANDARD TABLE OF e071.

    CALL FUNCTION 'TMS_WBO_READ_REQUEST'
      EXPORTING
        iv_request = iv_task
      IMPORTING
        es_e070    = ls_e070
      TABLES
        tt_e071    = lt_object.

    mt_object = VALUE #( BASE mt_object FOR ls_row IN lt_object ( type = ls_row-object
                                                                  name = ls_row-obj_name
                                                                  transport = COND #( WHEN ls_e070-strkorr IS NOT INITIAL
                                                                                        THEN ls_e070-strkorr
                                                                                      ELSE iv_task ) ) ).
  ENDMETHOD.

  METHOD get_data.
    CHECK mt_object IS NOT INITIAL.

    SELECT objtype, objname, versno, lastversno
      FROM vrsd
      INTO TABLE @mt_object_version
      FOR ALL ENTRIES IN @mt_object
      WHERE objtype = @mt_object-type
        AND objname = @mt_object-name
        AND korrnum = @mt_object-transport.
  ENDMETHOD.

  METHOD process_data.
    LOOP AT mt_object_version ASSIGNING FIELD-SYMBOL(<lfs_object_version>).
      set_version( CHANGING cs_object_version = <lfs_object_version> ).
      process_object( <lfs_object_version> ).
    ENDLOOP.
  ENDMETHOD.

  METHOD set_version.
    cs_object_version-object_version = COND #( WHEN cs_object_version-object_version IS NOT INITIAL
                                                THEN cs_object_version-object_version - 1
                                               ELSE cs_object_version-last_version ).
  ENDMETHOD.

  METHOD process_object.
    set_code( is_object ).
    call_comparison( is_object-object_name ).
  ENDMETHOD.

  METHOD set_code.
    CASE is_object-object_type.
      WHEN mc_report OR mc_method.
        process_code( is_object ).

      WHEN mc_interface.
        process_interface( is_object ).
    ENDCASE.
  ENDMETHOD.

  METHOD process_code.
    version_lft  = is_object-object_version + 1.
    version_rgt  = is_object-object_version.
    objtype_rgt = objtype_lft = is_object-object_type.
    objname_rgt = objname_lft = is_object-object_name.

    PERFORM get_versions.
  ENDMETHOD.

  METHOD process_interface.
    DATA: lr_target_interface    TYPE REF TO if_fp_interface,
          lr_reference_interface TYPE REF TO if_fp_interface.

    TRY.
        lr_target_interface = CAST #( cl_fp_wb_helper=>interface_create_from_version( i_name = CONV #( is_object-object_name )
                                                                                      i_version = CONV #( is_object-object_version + 1 ) )->get_object(  ) ).
        lr_reference_interface = CAST #( cl_fp_wb_helper=>interface_create_from_version( i_name = CONV #( is_object-object_name )
                                                                                         i_version = is_object-object_version )->get_object(  ) ).

        abaptext_sec[] = VALUE #( FOR ls_row IN lr_target_interface->get_interface_data(  )->get_coding(  )->get_forms_coding(  )
                                  ( line = ls_row ) ).
        abaptext_pri[] = VALUE #( FOR ls_row IN lr_reference_interface->get_interface_data(  )->get_coding(  )->get_forms_coding(  )
                                  ( line = ls_row ) ).
      CATCH cx_fp_api_repository.
        RETURN.
      CATCH cx_fp_api_internal.
        RETURN.
    ENDTRY.
  ENDMETHOD.

  METHOD call_comparison.
    get_comp( ).
    call_delta( ).
    process_delta( iv_object_name ).
  ENDMETHOD.

  METHOD get_comp.
    SELECT SINGLE comp_mode
        FROM vers_udefs
        INTO @comp_mode
        WHERE uname = @sy-uname.
  ENDMETHOD.

  METHOD call_delta.
    CALL FUNCTION 'SVRS_COMPUTE_DELTA_REPS'
      EXPORTING
        compare_mode            = CONV sy-index( comp_mode )
        ignore_case_differences = abap_true
      TABLES
        texttab_old             = abaptext_sec
        texttab_new             = abaptext_pri
        trdirtab_old            = trdir_sec
        trdirtab_new            = trdir_pri
        trdir_delta             = trdir_delta
        text_delta              = abaptext_delta.
  ENDMETHOD.

  METHOD process_delta.
    CONSTANTS: lc_insert_flag TYPE sychar04 VALUE 'I'.

    mt_output = VALUE #( BASE mt_output FOR
                          ls_row IN abaptext_delta ( object_name = iv_object_name
                                                     line_number = ls_row-number
                                                     new_code = COND #( WHEN ls_row-vrsflag <> lc_insert_flag THEN ls_row-line )
                                                     old_code = COND #( WHEN ls_row-vrsflag = lc_insert_flag THEN ls_row-line ) ) ).
  ENDMETHOD.

  METHOD display_output.
    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lr_alv)
                                CHANGING t_table = mt_output ).
      CATCH cx_salv_msg.
        RETURN.
    ENDTRY.

    DATA(lo_columns) = lr_alv->get_columns( ).

    set_output_text( iv_column = 'LINE_NUMBER' iv_text = 'Line' io_column = lo_columns ).
    set_output_text( iv_column = 'EDIT_TYPE' iv_text = 'Edit' io_column = lo_columns ).
    set_output_text( iv_column = 'NEW_CODE' iv_text = 'New Code' io_column = lo_columns ).
    set_output_text( iv_column = 'OLD_CODE' iv_text = 'Old Code' io_column = lo_columns ).

    lr_alv->get_columns( )->set_optimize( abap_true ).
    lr_alv->display( ).
  ENDMETHOD.

  METHOD set_output_text.
    TRY.
        io_column->get_column( iv_column )->set_long_text( CONV #( iv_text ) ).
        io_column->get_column( iv_column )->set_medium_text( CONV #( iv_text ) ).
        io_column->get_column( iv_column )->set_short_text( CONV #( iv_text ) ).
      CATCH cx_salv_not_found.
        RETURN.
    ENDTRY.
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
  NEW main( )->run( ).
