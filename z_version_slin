TABLES: vrsdynpro.

DATA: keep_pos                   TYPE bool,
      delta_only                 TYPE bool,
      with_korrnum               TYPE bool,
      korrtxt_lft                TYPE e07t-as4text,
      korrtxt_rgt                TYPE e07t-as4text,
      korrnum_rgt                TYPE vrsd-korrnum,
      e07t_entry                 TYPE e07t,
      logdest_rgt                TYPE rfcdes-rfcdest,
      korrnum_lft                TYPE vrsd-korrnum,
      logdest_lft                TYPE rfcdes-rfcdest,
      no_delta                   TYPE bool,
      gv_ignore_case_differences TYPE bool VALUE 'X',
      comp_mode                  TYPE vers_comp,
      abaptext_sec               TYPE STANDARD TABLE OF abaptxt255,
      abaptext_pri               TYPE STANDARD TABLE OF abaptxt255,
      trdir_sec                  TYPE STANDARD TABLE OF trdir,
      trdir_pri                  TYPE STANDARD TABLE OF trdir,
      trdir_delta                TYPE STANDARD TABLE OF xtrdir,
      abaptext_delta             TYPE STANDARD TABLE OF vxabapt255,
      version_lft                TYPE vrsd-versno,
      objtype_lft                TYPE vrsd-objtype,
      objname_lft                TYPE vrsd-objname,
      gt_smodilog_lft            TYPE STANDARD TABLE OF smodilog,
      version_rgt                TYPE vrsd-versno,
      objtype_rgt                TYPE vrsd-objtype,
      objname_rgt                TYPE vrsd-objname,
      gt_smodilog_rgt            TYPE STANDARD TABLE OF smodilog,
      one_column                 TYPE bool,
      objtyp1                    TYPE vrsd-objtype,
      objtyp2                    TYPE vrsd-objtype,
      gv_transport               TYPE trkorr,

      BEGIN OF fcode_tab OCCURS 5,
        fcode TYPE sy-ucomm,
      END OF fcode_tab.

INCLUDE: rsvcutct, rsvcrslt, rsvcrsst.

SELECT-OPTIONS: s_task FOR gv_transport NO INTERVALS OBLIGATORY.

PARAMETERS: p_custom AS CHECKBOX.

CLASS main DEFINITION FINAL.
  PUBLIC SECTION.
    METHODS: run.
  PRIVATE SECTION.
    TYPES: BEGIN OF ty_index,
             original_index   TYPE syst_tabix,
             normalized_index TYPE int2,
           END OF ty_index,

           tty_indexes TYPE SORTED TABLE OF ty_index WITH UNIQUE KEY original_index,

           BEGIN OF ty_object,
             type      TYPE trobjtype,
             name      TYPE versobjnam,
             transport TYPE strkorr,
           END OF ty_object,

           BEGIN OF ty_object_version,
             object_type    TYPE versobjtyp,
             object_name    TYPE versobjnam,
             object_version TYPE versno,
             last_version   TYPE versno,
           END OF ty_object_version,

           BEGIN OF ty_text,
             line     TYPE string,
             line_num TYPE syst_tabix,
           END OF ty_text,

           BEGIN OF ty_mapping,
             new_line TYPE syst_tabix,
             old_line TYPE syst_tabix,
           END OF ty_mapping,

           BEGIN OF ty_seen,
             code_string TYPE string,
             indexes     TYPE tty_indexes,
           END OF ty_seen,

           BEGIN OF ty_output,
             object_name TYPE versobjnam,
             flag        TYPE char1,
             line_number TYPE syst_tabix,
             code_string TYPE text255,
           END OF ty_output,

           tty_abaptxt TYPE STANDARD TABLE OF abaptxt255 WITH DEFAULT KEY,
           tty_text    TYPE STANDARD TABLE OF ty_text WITH DEFAULT KEY,
           tty_seen    TYPE HASHED TABLE OF ty_seen WITH UNIQUE KEY code_string.

    CONSTANTS: mc_report    TYPE c LENGTH 4 VALUE 'REPS',
               mc_interface TYPE c LENGTH 4 VALUE 'SFPI',
               mc_method    TYPE c LENGTH 4 VALUE 'METH',
               mc_insert    TYPE c LENGTH 1 VALUE '+',
               mc_delete    TYPE c LENGTH 1 VALUE '-'.

    DATA: mt_object         TYPE STANDARD TABLE OF ty_object,
          mt_object_version TYPE STANDARD TABLE OF ty_object_version,
          mt_new_code       TYPE tty_seen,
          mt_old_code       TYPE tty_seen,
          mt_mapping        TYPE HASHED TABLE OF ty_mapping WITH UNIQUE KEY new_line old_line,
          mt_output         TYPE STANDARD TABLE OF ty_output.

    METHODS: read_task,
      get_object IMPORTING iv_task TYPE trkorr,
      get_data,
      process_data,
      set_version CHANGING cs_object_version TYPE ty_object_version,
      process_object IMPORTING is_object TYPE ty_object_version,
      set_code IMPORTING is_object TYPE ty_object_version,
      process_code IMPORTING is_object TYPE ty_object_version,
      process_interface IMPORTING is_object TYPE ty_object_version,
      call_comparison IMPORTING iv_object_name TYPE versobjnam,
      custom_difference,
      normalize_code IMPORTING it_code          TYPE tty_abaptxt
                     CHANGING  ct_code          TYPE tty_seen
                     RETURNING VALUE(rt_output) TYPE tty_text,
      custom_comparison IMPORTING it_reference_code TYPE tty_text
                                  it_target_code    TYPE tty_text
                                  iv_flag           TYPE c,
      add_mapping IMPORTING iv_flag            TYPE c
                            iv_reference_index TYPE syst_tabix
                  CHANGING  cs_mapping         TYPE ty_mapping,
      search_code IMPORTING iv_reference_index   TYPE syst_tabix
                            it_reference_indexes TYPE tty_indexes
                  RETURNING VALUE(rv_output)     TYPE ty_index,
      validate_mapping,
      clear_custom_data,
      populate_output IMPORTING iv_object_name TYPE versobjnam,
      call_delta,
      standard_difference IMPORTING iv_object_name TYPE versobjnam,
      display_output,
      set_output_text IMPORTING iv_column TYPE lvc_fname
                                iv_text   TYPE scrtext
                                io_column TYPE REF TO cl_salv_columns_table.
ENDCLASS.

CLASS main IMPLEMENTATION.
  METHOD run.
    read_task( ).
    get_data( ).
    process_data( ).
    display_output( ).
  ENDMETHOD.

  METHOD read_task.
    LOOP AT s_task ASSIGNING FIELD-SYMBOL(<lfs_task>).
      get_object( <lfs_task>-low ).
    ENDLOOP.
  ENDMETHOD.

  METHOD get_object.
    DATA: ls_e070   TYPE e070,
          lt_object TYPE STANDARD TABLE OF e071.

    CALL FUNCTION 'TMS_WBO_READ_REQUEST'
      EXPORTING
        iv_request = iv_task
      IMPORTING
        es_e070    = ls_e070
      TABLES
        tt_e071    = lt_object.

    mt_object = VALUE #( BASE mt_object FOR ls_row IN lt_object ( type = ls_row-object
                                                                  name = ls_row-obj_name
                                                                  transport = COND #( WHEN ls_e070-strkorr IS NOT INITIAL
                                                                                      THEN ls_e070-strkorr
                                                                                      ELSE iv_task ) ) ).
  ENDMETHOD.

  METHOD get_data.
    CHECK mt_object IS NOT INITIAL.

    SELECT objtype, objname, versno, lastversno
      FROM vrsd
      INTO TABLE @mt_object_version
      FOR ALL ENTRIES IN @mt_object
      WHERE objtype = @mt_object-type
        AND objname = @mt_object-name
        AND korrnum = @mt_object-transport.
  ENDMETHOD.

  METHOD process_data.
    LOOP AT mt_object_version ASSIGNING FIELD-SYMBOL(<lfs_object_version>).
      set_version( CHANGING cs_object_version = <lfs_object_version> ).
      process_object( <lfs_object_version> ).
    ENDLOOP.
  ENDMETHOD.

  METHOD set_version.
    cs_object_version-object_version = COND #( WHEN cs_object_version-object_version IS NOT INITIAL
                                               THEN cs_object_version-object_version - 1
                                               ELSE cs_object_version-last_version ).
  ENDMETHOD.

  METHOD process_object.
    set_code( is_object ).
    call_comparison( is_object-object_name ).
  ENDMETHOD.

  METHOD set_code.
    CASE is_object-object_type.
      WHEN mc_report OR mc_method.
        process_code( is_object ).

      WHEN mc_interface.
        process_interface( is_object ).
    ENDCASE.
  ENDMETHOD.

  METHOD process_code.
    version_lft  = is_object-object_version + 1.
    version_rgt  = is_object-object_version.
    objtype_rgt = objtype_lft = is_object-object_type.
    objname_rgt = objname_lft = is_object-object_name.

    PERFORM get_versions.
  ENDMETHOD.

  METHOD process_interface.
    DATA: lr_target_interface    TYPE REF TO if_fp_interface,
          lr_reference_interface TYPE REF TO if_fp_interface.

    TRY.
        lr_target_interface = CAST #( cl_fp_wb_helper=>interface_create_from_version( i_name = CONV #( is_object-object_name )
                                                                                      i_version = CONV #( is_object-object_version + 1 ) )->get_object(  ) ).
        lr_reference_interface = CAST #( cl_fp_wb_helper=>interface_create_from_version( i_name = CONV #( is_object-object_name )
                                                                                         i_version = is_object-object_version )->get_object(  ) ).

        abaptext_sec[] = VALUE #( FOR ls_row IN lr_target_interface->get_interface_data(  )->get_coding(  )->get_forms_coding(  )
                                  ( line = ls_row ) ).
        abaptext_pri[] = VALUE #( FOR ls_row IN lr_reference_interface->get_interface_data(  )->get_coding(  )->get_forms_coding(  )
                                  ( line = ls_row ) ).
      CATCH cx_fp_api_repository.
        MESSAGE |Issue with repository API for { is_object-object_name }| TYPE 'I'.
      CATCH cx_fp_api_internal.
        MESSAGE |Issue with internal API for { is_object-object_name }| TYPE 'I'.
    ENDTRY.
  ENDMETHOD.

  METHOD call_comparison.
    IF p_custom IS NOT INITIAL.
      custom_difference( ).
      "validate_mapping( ). "Meant to validate mapping but current logic implementation should have no issues
      populate_output( iv_object_name ).
      clear_custom_data( ).

    ELSE.
      call_delta( ).
      standard_difference( iv_object_name ).
    ENDIF.
  ENDMETHOD.

  METHOD custom_difference.
    DATA(it_old) = normalize_code( EXPORTING it_code = abaptext_pri[] CHANGING ct_code = mt_old_code ).
    DATA(it_new) = normalize_code( EXPORTING it_code = abaptext_sec[] CHANGING ct_code = mt_new_code ).
    custom_comparison( it_reference_code = it_old it_target_code = it_new iv_flag = mc_insert ).
    custom_comparison( it_reference_code = it_new it_target_code = it_old iv_flag = mc_delete ).
  ENDMETHOD.

  METHOD normalize_code.
    CONSTANTS: lc_star  TYPE c LENGTH 1 VALUE '*',
               lc_quote TYPE c LENGTH 1 VALUE '"'.

    DATA(lv_normalized_index) = 1.

    LOOP AT it_code ASSIGNING FIELD-SYMBOL(<lfs_code>) WHERE line IS NOT INITIAL.
      DATA(lv_original_index) = sy-tabix.
      DATA(lv_first_char) = substring( val = <lfs_code>-line len = 1 ).

      IF lv_first_char = lc_star OR lv_first_char = lc_quote.
        CONTINUE.
      ENDIF.

      SPLIT <lfs_code>-line AT lc_quote INTO DATA(lv_code) DATA(lv_comment).

      rt_output = VALUE #( BASE rt_output ( line = to_upper( condense( lv_code ) )
                                            line_num = lv_original_index ) ).

      IF NOT line_exists( ct_code[ code_string = lv_code ] ).
        INSERT VALUE #( code_string = lv_code ) INTO TABLE ct_code.
      ENDIF.

      ct_code[ code_string = lv_code ]-indexes = VALUE #( BASE ct_code[ code_string = lv_code ]-indexes
                                                                        ( original_index = lv_original_index
                                                                          normalized_index = lv_normalized_index ) ).
      lv_normalized_index = lv_normalized_index + 1.
    ENDLOOP.
  ENDMETHOD.

  METHOD custom_comparison.
    DATA(lv_reference_index) = 1.

    LOOP AT it_target_code ASSIGNING FIELD-SYMBOL(<lfs_target>).
      DATA(lv_target_index) = <lfs_target>-line_num.
      DATA(ls_mapping) = VALUE ty_mapping( new_line = COND #( WHEN iv_flag = mc_insert THEN lv_target_index )
                                           old_line = COND #( WHEN iv_flag = mc_delete THEN lv_target_index ) ).

      IF iv_flag = mc_delete AND line_exists( mt_mapping[ old_line = lv_target_index ] )
        OR lv_reference_index > lines( it_reference_code ).
        CONTINUE.
      ENDIF.

      IF it_reference_code[ lv_reference_index ]-line = <lfs_target>-line.
        add_mapping( EXPORTING iv_flag = iv_flag iv_reference_index = VALUE #( it_reference_code[ lv_reference_index ]-line_num )
                     CHANGING cs_mapping = ls_mapping ).
        lv_reference_index = lv_reference_index + 1.

      ELSEIF iv_flag = mc_insert AND line_exists( mt_old_code[ code_string = <lfs_target>-line ] ).
        DATA(lv_temp_index) = search_code( iv_reference_index = VALUE #( it_reference_code[ lv_reference_index ]-line_num )
                                           it_reference_indexes = mt_old_code[ code_string = <lfs_target>-line ]-indexes ).

        IF lv_temp_index IS NOT INITIAL.
          add_mapping( EXPORTING iv_flag = iv_flag iv_reference_index = lv_temp_index-original_index
                       CHANGING cs_mapping = ls_mapping ).

          lv_reference_index = lv_temp_index-normalized_index + 1.
        ENDIF.
      ENDIF.

      mt_mapping = VALUE #( BASE mt_mapping ( ls_mapping ) ).
    ENDLOOP.
  ENDMETHOD.

  METHOD add_mapping.
    CASE iv_flag.
      WHEN mc_insert.
        cs_mapping-old_line = iv_reference_index.

      WHEN mc_delete.
        cs_mapping-new_line = iv_reference_index.
    ENDCASE.
  ENDMETHOD.

  METHOD search_code.
    LOOP AT it_reference_indexes ASSIGNING FIELD-SYMBOL(<lfs_reference>) WHERE original_index > iv_reference_index.
      IF line_exists( mt_mapping[ old_line = <lfs_reference>-original_index ] ).
        CONTINUE.
      ENDIF.

      rv_output = <lfs_reference>.
      RETURN.
    ENDLOOP.
  ENDMETHOD.

  METHOD validate_mapping.
    DATA(lv_old_max) = 0.

    LOOP AT mt_mapping ASSIGNING FIELD-SYMBOL(<lfs_mapping>).
      IF <lfs_mapping>-new_line IS NOT INITIAL AND <lfs_mapping>-old_line IS NOT INITIAL.
        IF <lfs_mapping>-old_line < lv_old_max.
          MESSAGE |Wrong mapping with new line { <lfs_mapping>-new_line }| TYPE 'I'.

        ELSE.
          lv_old_max = <lfs_mapping>-old_line.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD clear_custom_data.
    CLEAR: mt_new_code,
           mt_old_code,
           mt_mapping.
  ENDMETHOD.

  METHOD populate_output.
    LOOP AT mt_mapping ASSIGNING FIELD-SYMBOL(<lfs_mapping>).
      IF <lfs_mapping>-new_line IS INITIAL OR <lfs_mapping>-old_line IS INITIAL.

        mt_output = VALUE #( BASE mt_output ( COND #( WHEN <lfs_mapping>-new_line IS NOT INITIAL
                                                      THEN VALUE #( object_name = iv_object_name
                                                                    flag = mc_insert
                                                                    line_number = <lfs_mapping>-new_line
                                                                    code_string = abaptext_sec[ <lfs_mapping>-new_line ] )
                                                      ELSE VALUE #( object_name = iv_object_name
                                                                    flag = mc_delete
                                                                    line_number = <lfs_mapping>-old_line
                                                                    code_string = abaptext_pri[ <lfs_mapping>-old_line ] ) ) ) ).
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD call_delta.
    SELECT SINGLE comp_mode
        FROM vers_udefs
        INTO @comp_mode
        WHERE uname = @sy-uname.

    CALL FUNCTION 'SVRS_COMPUTE_DELTA_REPS'
      EXPORTING
        compare_mode            = CONV sy-index( comp_mode )
        ignore_case_differences = abap_true
      TABLES
        texttab_old             = abaptext_sec
        texttab_new             = abaptext_pri
        trdirtab_old            = trdir_sec
        trdirtab_new            = trdir_pri
        trdir_delta             = trdir_delta
        text_delta              = abaptext_delta.
  ENDMETHOD.

  METHOD standard_difference.
    CONSTANTS: lc_insert_flag TYPE sychar04 VALUE 'I'.

    mt_output = VALUE #( BASE mt_output FOR
                          ls_row IN abaptext_delta ( object_name = iv_object_name
                                                     flag = COND #( WHEN ls_row-vrsflag <> lc_insert_flag THEN mc_insert
                                                                    ELSE mc_delete )
                                                     line_number = ls_row-number
                                                     code_string = ls_row-line ) ).
  ENDMETHOD.

  METHOD display_output.
    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lr_alv)
                                CHANGING t_table = mt_output ).
      CATCH cx_salv_msg.
        RETURN.
    ENDTRY.

    DATA(lo_columns) = lr_alv->get_columns( ).

    set_output_text( iv_column = 'LINE_NUMBER' iv_text = 'Line' io_column = lo_columns ).
    set_output_text( iv_column = 'FLAG' iv_text = 'Edit' io_column = lo_columns ).
    set_output_text( iv_column = 'CODE_STRING' iv_text = 'Code' io_column = lo_columns ).

    lr_alv->get_columns( )->set_optimize( abap_true ).
    lr_alv->display( ).
  ENDMETHOD.

  METHOD set_output_text.
    TRY.
        io_column->get_column( iv_column )->set_long_text( CONV #( iv_text ) ).
        io_column->get_column( iv_column )->set_medium_text( CONV #( iv_text ) ).
        io_column->get_column( iv_column )->set_short_text( CONV #( iv_text ) ).
      CATCH cx_salv_not_found.
        RETURN.
    ENDTRY.
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
  NEW main( )->run( ).
